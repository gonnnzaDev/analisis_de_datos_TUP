# Copiá este archivo a `.env` y ajustá lo que necesites.
# Todos los valores son opcionales: si no están, se usan los de src/config.py.

# --- IA local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b
OLLAMA_TIMEOUT=1800
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
IA_FRAGMENTO_CARACTERES=6000
IA_FRAGMENTO_SOLAPE=300

# --- Extracción ---
PAUSA_STORE=1.7
PAUSA_API=0.5
HTTP_TIMEOUT=40
HTTP_REINTENTOS=4
PAIS=ar
IDIOMA=spanish

# --- Lotes ---
LOTE_TAMANO=100
SEMILLA=2026

# --- Ingesta de datos externos y OCR ---
# Modelo multimodal de Ollama para revisar imágenes y transcribir (OCR).
OLLAMA_MODELO_VISION=qwen2.5vl:3b
# auto = IA de visión si está; si no, Tesseract. También: ollama | tesseract
INGESTA_MOTOR_OCR=auto
INGESTA_OCR_MAX_PAGINAS=15
INGESTA_OCR_DPI=150
INGESTA_OCR_ANCHO_MAX=2200
# Si un PDF tiene menos caracteres por página que esto, se considera escaneado.
INGESTA_MIN_CARACTERES_PDF=40
# Cuánto texto se le manda a la IA para verificar un dato.
INGESTA_MAX_CARACTERES_IA=12000
# Tamaño máximo de un archivo externo (en MB).
INGESTA_MAX_MB=50
# Carpeta donde se pueden dejar archivos para `python pipeline.py ingerir`.
DIRECTORIO_ENTRADA=entrada

# --- SteamDB ---
STEAMDB_USAR_NAVEGADOR=1
STEAMDB_NAVEGADOR_VISIBLE=1
STEAMDB_ESPERA_NAVEGADOR=15

# --- Datos ---
DIRECTORIO_DATOS=data
